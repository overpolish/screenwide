<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SPDX-FileCopyrightText: 2026 overpolish -->
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<plist version="1.0">
<dict>
  <!-- macOS keeps large freed allocations cached for reuse and does not hand
       them back, even under memory pressure: a recording's frames left the
       app holding hundreds of megabytes it no longer used. -->
  <key>LSEnvironment</key>
  <dict>
    <key>MallocLargeCache</key>
    <string>0</string>
  </dict>
  <key>LSUIElement</key>
  <true/>
  <key>NSCameraUsageDescription</key>
  <string>Screenwide uses your camera when you include it in a recording.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Screenwide uses your microphone when you record audio.</string>
  <key>NSAudioCaptureUsageDescription</key>
  <string>Screenwide records system and app audio when you include it in a recording.</string>
</dict>
</plist>
