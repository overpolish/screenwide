<plist version="1.0">
<dict>
  <!-- A release is signed with the hardened runtime, under which macOS
       neither asks for nor grants the microphone or the camera unless the
       signature claims them here; a development build has no hardened
       runtime, so it asks either way. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.device.camera</key>
  <true/>
</dict>
</plist>
