{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "text-recognition-opener",
  "description": "Open supported QR actions from text recognition overlays",
  "windows": ["text-recognition-*"],
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" },
        { "url": "mailto:*" },
        { "url": "sms:*" },
        { "url": "tel:*" }
      ]
    }
  ]
}
