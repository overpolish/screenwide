{
  "formatVersion": 4,
  "id": "highlight",
  "name": "Highlight",
  "author": "Screenwide",
  "version": "1.0.0",
  "description": "The word being said on a bright pill of its own.",
  "fonts": [
    {
      "file": "fonts/InstrumentSerif-Regular.ttf",
      "family": "Instrument Serif",
      "weights": [400],
      "license": "fonts/InstrumentSerif-OFL-1.1.txt"
    },
    {
      "file": "fonts/InstrumentSerif-Italic.ttf",
      "family": "Instrument Serif",
      "weights": [400],
      "italic": true,
      "license": "fonts/InstrumentSerif-OFL-1.1.txt"
    }
  ],
  "style": {
    "font": {
      "weight": 800,
      "italic": false
    },
    "sizePercent": 120,
    "allCaps": true,
    "maxWords": 4,
    "lines": "one",
    "background": "word",
    "highlightWords": true
  }
}
