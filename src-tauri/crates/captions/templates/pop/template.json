{
  "formatVersion": 4,
  "id": "pop",
  "name": "Pop",
  "author": "Screenwide",
  "version": "1.0.0",
  "description": "Big type a few words at a time, each caption popping in where it sits.",
  "fonts": [
    {
      "file": "fonts/InstrumentSerif-Regular.ttf",
      "family": "Instrument Serif",
      "weights": [400],
      "license": "fonts/InstrumentSerif-OFL-1.1.txt"
    },
    {
      "file": "fonts/InstrumentSerif-Italic.ttf",
      "family": "Instrument Serif",
      "weights": [400],
      "italic": true,
      "license": "fonts/InstrumentSerif-OFL-1.1.txt"
    }
  ],
  "style": {
    "font": {
      "weight": 800,
      "italic": false
    },
    "sizePercent": 140,
    "allCaps": true,
    "maxWords": 3,
    "lines": "one",
    "motion": "pop"
  }
}
