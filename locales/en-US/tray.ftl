### The menu bar or notification area icon: its menu and its tooltip.

## Menu items, in title case where the platform uses it.

tray-open = Open Screenwide
tray-projects = Projects
tray-open-clipboard-screenshot = Open Screenshot from Clipboard
tray-delayed-screenshot = Delayed Screenshot
tray-cancel-delayed-screenshot = Cancel Delayed Screenshot
tray-pause-recording = Pause Recording
tray-resume-recording = Resume Recording
tray-stop-recording = Stop Recording
tray-discard-recording = Discard Recording
# Shown instead of Discard while a recording is still starting.
tray-cancel-recording = Cancel Recording
tray-replay-on = Turn On Replay Buffer
tray-replay-off = Turn Off Replay Buffer
tray-replay-save = Save Replay
tray-recognize-text = Recognize Text/QR
tray-ruler = Ruler Overlay
tray-annotate = Annotate
tray-clear-annotations = Clear Annotations
tray-settings = Settings
tray-quit = Quit Screenwide

## Tooltips: the app's name, then what it is doing.

tray-tooltip = Screenwide
tray-tooltip-starting = Screenwide - Starting a recording
tray-tooltip-recording = Screenwide - Recording
tray-tooltip-paused = Screenwide - Recording paused
tray-tooltip-stopping = Screenwide - Finishing the recording
tray-tooltip-replay = Screenwide - Replay buffer on
tray-tooltip-replay-saved = Screenwide - Replay saved
# $seconds: seconds left before a Delayed Screenshot is taken.
tray-tooltip-countdown = Screenwide - Screenshot in { $seconds }s
