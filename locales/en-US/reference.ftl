### Reference: a screenshot kept on screen at its true size, to compare against what is there now, and the island under it.

# Names the island for assistive technology.
reference-island = Reference
# Names the choice that makes the reference see-through, so what is under it shows.
reference-opacity = Opacity
# Names the button that puts the reference back over the area it was taken from.
reference-to-origin = Back to where it was taken
# Names the button that puts a reference with nowhere to return to back to its
# true size, as a dropped picture is.
reference-reset-size = Reset size
reference-copy = Copy reference
# Spoken once the reference is on the clipboard.
reference-copied = Copied
reference-open-in-editor = Open in editor
# Closing a reference deletes its picture, so the button asks twice.
reference-close = Close reference
# The close button's second state: a press now closes it and deletes the picture.
reference-close-confirm = Close and discard
# The island while a picture is dragged with Option held, as letting go keeps
# it as a reference.
reference-drop-island = Reference drop
reference-drop-hint = Drop to keep as a reference
