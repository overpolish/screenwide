### The alert window that reports a failure.

alert-dismiss = OK

## Titles. The message below a title gives the technical reason, which stays in English.

alert-recording-start-failed = Recording could not start
alert-recording-capture-failed = Recording ran into a problem
alert-recording-resume-failed = Recording could not resume
alert-recording-finish-failed = Recording could not finish
alert-replay-start-failed = Replay buffer could not turn on
# After the computer wakes from sleep.
alert-replay-restart-failed = Replay buffer could not turn back on
alert-replay-stopped = Replay buffer stopped
alert-replay-save-failed = Replay could not be saved
alert-project-open-failed = Project could not open
alert-caption-template-import-failed = Caption template could not be imported
alert-caption-template-export-failed = Caption template could not be exported
alert-caption-template-remove-failed = Caption template could not be removed
