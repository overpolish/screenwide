### Annotate: drawing on the desktop live, and its floating toolbar.

annotate-tools = Annotation tools
annotate-undo = Undo
annotate-undo-label = Undo the last annotation
annotate-clear = Clear
annotate-clear-label = Clear annotations
annotate-close = Close
annotate-close-label = Close the annotate overlay

# The island: a size it offers to choose, an arrow's stroke or a counter's disc, in points.
annotate-island-points = { $points } pt
# The island's note under the highlight tool: the key that, held through a drag, lays the highlight the other way, over the box dragged or fitted to text. $key is the key, drawn as a keycap.
annotate-island-highlight-fit-hint = Hold { $key } to highlight a box instead.
annotate-island-highlight-box-hint = Hold { $key } to fit the highlight to text instead.
# The island's corner presets for a shape: square corners, rounded ones, and rounded all the way into a circle.
annotate-island-corners-square = Square
annotate-island-corners-rounded = Rounded
annotate-island-corners-round = Round
# The island's note beside the freehand pen: resting at the end of a stroke replaces it with a cleaned-up version of what was drawn, whether a line, a curve, an arrow or a closed shape.
annotate-island-draw-hint = Pause at the end to smooth it out.
# The island's focus tool, which draws attention to a box by treating what lies around it: its name, and the two ways it treats the surroundings, blurring them or dimming them.
annotate-island-focus-name = Focus on a region
annotate-island-focus-blur = Blur
annotate-island-focus-dim = Dim
