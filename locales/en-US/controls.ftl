### Controls every window shares: fields, lists, window buttons and key caps.

controls-no-items = No items found.
controls-no-content = No Content
controls-sidebar-collapse = Collapse sidebar
controls-sidebar-expand = Expand sidebar
controls-document-name = Document name
# Said aloud after a copy button copies.
controls-copied = Copied
# A field showing a chosen folder, pressed to choose another. $label names what the folder is for; $path is the folder's full path.
controls-path-field = { $label }: { $path }
# Shown in a folder field before a folder is chosen.
controls-path-field-choose = Choose folder
# $label names the value the slider and field set together.
controls-slider = { $label } slider
controls-slider-value = { $label } value
# Returns a value to its default. $label names the value, such as Space around windows.
controls-reset = Reset { $label }
# An audio level meter's reading for a screen reader. $decibels is a whole number, 0 at full scale and negative below it.
controls-audio-meter-value = { $decibels } dB
# An audio level meter whose input is quiet or switched off.
controls-audio-meter-silent = Silent

## Window buttons on Windows

controls-window-minimize = Minimize
controls-window-maximize = Maximize
controls-window-restore = Restore
controls-window-close = Close

## Key names, as each platform prints them on its keys

controls-key-shift = Shift
controls-key-command = Command
controls-key-option = Option
# Control on a Mac, where its key is drawn as a symbol.
controls-key-control = Control
# Control on Windows, as the key is labelled.
controls-key-ctrl = Ctrl
controls-key-alt = Alt
controls-key-windows = Win
controls-key-escape = Esc
controls-key-space = Space
controls-key-enter = Enter
controls-key-tab = Tab
controls-key-delete = Delete
controls-key-backspace = Backspace
# The arrow keys, which a Mac draws as arrows and names this way to a screen reader.
controls-key-up = Up
controls-key-down = Down
controls-key-left = Left
controls-key-right = Right
controls-key-mouse-middle = Middle click
controls-key-mouse-back = Mouse Back
controls-key-mouse-forward = Mouse Forward
