### Ruler: measuring on the desktop, and its tools on the island.

ruler-island-tools = Ruler tools
# The tools: what a click on the desktop does.
ruler-island-measure = Measure
ruler-island-vertical-guide = Vertical guide
ruler-island-horizontal-guide = Horizontal guide
ruler-island-radius = Corner radius
# Notes under the tool in hand, saying what a click on the desktop does with it.
# Under Measure: the keys that stamp a measurement where the pointer is, across and down. $horizontal and $vertical are the keys, drawn as keycaps.
ruler-island-measure-hint = Press { $horizontal } to stamp a width, { $vertical } for a height.
ruler-island-guide-hint = Click to place a guide.
ruler-island-radius-hint = Hover a corner, then click to keep its radius.
# Opens the choice of how faint an edge the ruler snaps to.
ruler-island-edges = Edge detection
ruler-island-centerlines = Show centerlines
ruler-island-crosshair = Show crosshair
ruler-island-undo = Undo
ruler-island-copy = Copy the latest measurement
ruler-island-close = Close the ruler
