### Screenshots, and the scrolling capture of a page taller than the screen.

## The island while a scrolling capture runs

# Names the island for assistive technology.
screenshots-scrolling-island = Scrolling capture
# The island's title: what the capture is doing now.
screenshots-scrolling-capturing = Capturing
screenshots-scrolling-stitching = Stitching
screenshots-scrolling-working = Working
screenshots-scrolling-finishing = Finishing
# Beside the progress bar under the title, saying what each phase does.
screenshots-scrolling-working-note = Scrolling to the top of the region.
screenshots-scrolling-capturing-note = Scrolling through the region, a frame at a time.
screenshots-scrolling-stitching-note = Joining the frames into one picture.
screenshots-scrolling-finishing-note = Almost done.
# Stops the capture while it is still scrolling.
screenshots-scrolling-cancel = Cancel
# Under the progress while Escape stops the capture. $key is the key, drawn as a keycap.
screenshots-scrolling-cancel-hint = Press { $key } to cancel.
