{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "screenwide-openverse",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "routes": [
    { "pattern": "openverse.getscreenwide.com", "custom_domain": true },
  ],
  // Searches each address may make: well inside what the app's
  // registration allows across everyone (100 a minute), so one address
  // cannot use it up for the rest.
  "ratelimits": [
    {
      "name": "SEARCHES",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  // Set with `wrangler secret put`, never written here: the app's
  // registration with Openverse (`POST /v1/auth_tokens/register/`).
  "secrets": {
    "required": ["OPENVERSE_CLIENT_ID", "OPENVERSE_CLIENT_SECRET"],
  },
}
