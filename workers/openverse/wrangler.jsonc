{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "screenwide-openverse",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "routes": [
    { "pattern": "openverse.getscreenwide.com", "custom_domain": true },
  ],
  // Questions sent on to Openverse in a burst, from one installation and
  // from one address: well inside what the app's registration allows
  // across everyone (100 a minute). The day's allowance is counted in
  // `Allowance` (`src/allowance.ts`).
  "ratelimits": [
    {
      "name": "PERSON_BURST",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "ADDRESS_BURST",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "ALLOWANCES", "class_name": "Allowance" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Allowance"] }],
  // Set with `wrangler secret put`, never written here: the app's
  // registration with Openverse (`POST /v1/auth_tokens/register/`).
  "secrets": {
    "required": ["OPENVERSE_CLIENT_ID", "OPENVERSE_CLIENT_SECRET"],
  },
}
